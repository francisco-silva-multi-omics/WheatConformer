{
  "protocol_version": "reaction_norm_rcp_historical_reconstruction_v1",
  "status": "frozen_before_historical_reconstruction",
  "selection_data": "environment_identifiers_metadata_and_outer_training_covariates_only",
  "phenotype_values_allowed": false,
  "outer_test_environment_identifiers_allowed": false,
  "outer_test_outcomes_allowed": false,
  "outer_test_metrics_allowed": false,
  "final_holdout_outcomes_allowed": false,
  "model_selection_allowed": false,
  "future_covariate_matrices_allowed": false,
  "rcp_predictions_allowed": false,
  "expected_unique_historical_source_count": 15,
  "crop_precipitation_backcast": {
    "replacement_feature": "api_d0_180_precipitation_total_mm",
    "window_start_days_after_sowing": 0,
    "window_end_days_after_sowing": 180,
    "minimum_paired_training_environments": 20,
    "minimum_candidate_coverage_fraction": 0.7,
    "minimum_pearson": 0.7,
    "maximum_normalized_rmse": 1.0,
    "minimum_median_ratio": 0.5,
    "maximum_median_ratio": 2.0,
    "minimum_fold_pass_rate": 1.0,
    "affine_calibration_allowed": false
  },
  "harvest_anchor": {
    "recorded_priority": [
      "harvest_finish_date",
      "harvest_start_date"
    ],
    "target_heading_or_maturity_dates_allowed": false,
    "season_length_model": "outer_training_country_median_then_outer_training_global_median",
    "minimum_country_donors": 5,
    "minimum_season_length_days": 60,
    "maximum_season_length_days": 365,
    "default_season_length_days_when_no_training_donors": 180
  },
  "daily_backcast_requests": {
    "harvest_months_before": 11,
    "antecedent_days_before_sowing": 90,
    "annual_candidate_period": "365_days_ending_day_before_sowing",
    "deduplicate_by_coordinates_and_date_window": true,
    "daily_values_must_not_be_silently_replaced_by_trial_season_aggregates": true
  },
  "pre_sowing_moisture_replacement": {
    "required_predictors": [
      "antecedent_precipitation_total_mm",
      "antecedent_et0_total_mm",
      "declared_pre_sowing_irrigation"
    ],
    "optional_predictors": [
      "soil_moisture_0_7_mean_m3m3",
      "soil_moisture_7_28_mean_m3m3",
      "declared_pre_sowing_irrigation_amount_mm"
    ],
    "fit_partition": "outer_training_environments_only",
    "global_mean_imputation_allowed": false,
    "unfetched_antecedent_weather_imputation_allowed": false
  },
  "annual_precipitation_audit": {
    "fields": [
      "TOTAL_PRECIPIT_IN_12_MONTHS",
      "ESTIMATE_TOTAL_PRECIPIT_IN_12_MONTHS"
    ],
    "plausible_mm_minimum": 0.0,
    "plausible_mm_maximum": 5000.0,
    "minimum_plausible_fraction": 0.95,
    "trial_season_annualization_is_diagnostic_only": true,
    "period_contract_requires_daily_backcast": true,
    "candidate_periods": [
      "365_days_ending_day_before_sowing",
      "calendar_year_containing_sowing",
      "365_days_ending_harvest_anchor"
    ]
  },
  "block_range_rules": {
    "development": {
      "primary_checks": "physical_count_or_temperature_domain,fold_training_robust_tail,formula_lineage",
      "global_standardized_z_is_hard_gate": false
    },
    "geo": {
      "primary_checks": "coordinate_domain,site_identity,training_site_distance",
      "global_standardized_z_is_hard_gate": false
    },
    "heat": {
      "primary_checks": "day_count_within_window_or_temperature_domain,fold_training_robust_tail",
      "global_standardized_z_is_hard_gate": false
    },
    "management": {
      "primary_checks": "declared_scenario,physical_domain,training_support,nonzero_prevalence",
      "global_standardized_z_is_hard_gate": false
    },
    "radiation": {
      "primary_checks": "nonnegative_accumulation_or_physical_mean_domain,fold_training_robust_tail",
      "global_standardized_z_is_hard_gate": false
    },
    "water": {
      "primary_checks": "nonnegative_accumulation_or_state_domain,fold_training_robust_tail,period_lineage",
      "global_standardized_z_is_hard_gate": false
    },
    "confidence": {
      "primary_checks": "binary_domain,deterministic_projection_lineage",
      "global_standardized_z_is_hard_gate": false
    }
  },
  "completion_policy": {
    "audit_pass_means_reconstruction_inventory_complete_not_projection_allowed": true,
    "all_historical_sources_must_have_one_terminal_replacement_status": true,
    "daily_work_queue_must_cover_every_blocked_daily_source": true,
    "annual_fields_must_remain_blocked_until_period_adjudication": true,
    "no_future_matrix_or_prediction_may_be_generated": true
  }
}
