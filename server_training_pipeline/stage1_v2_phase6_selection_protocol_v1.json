  "final_holdout_policy": {
    "sealed_until_historical_and_projection_compatible_models_are_frozen": true
  },
  "matched_seed_required": true,
  "matched_validation_observation_required": true,
  "matched_component_mask_required": true,
  "addition_of_unregistered_candidates_after_metric_access_allowed": false
