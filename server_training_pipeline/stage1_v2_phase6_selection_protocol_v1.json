  "selection_metrics": {
    "primary": "macro_trait_scenario_normalized_rmse",
    "tiebreaker": "macro_trait_scenario_pearson",
    "minimum_relative_nrmse_gain": 0.01,
    "minimum_paired_inner_fold_win_rate": 0.6666666666666666,
    "maximum_mean_pearson_drop": 0.005,
    "maximum_calibration_error_increase": 0.0
