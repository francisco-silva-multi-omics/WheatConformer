  "guards": {
    "primary_trait_maximum_relative_nrmse_loss": 0.01,
    "within_environment_centered_spearman_maximum_drop": 0.002,
    "within_environment_pairwise_accuracy_maximum_drop": 0.002,
    "information_class_maximum_relative_nrmse_loss": 0.02,
    "projection_inactive_environment_maximum_relative_nrmse_loss": 0.02,
    "minimum_rows_for_guard": 500,
    "minimum_groups_for_ranking_guard": 30,
    "inactive_component_rows_must_be_reported": true,
    "missing_component_is_never_zero_similarity": true
  },
  "mandatory_reporting_subsets": [
    "PEDIGREE_ONLY",
    "MARKER_SUPPORTED",
    "PEDIGREE_AND_MARKER",
