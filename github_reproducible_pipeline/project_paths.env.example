# Copy this file to project_paths.env and edit paths for your machine/server.

# Raw downloaded/unpacked CIMMYT and auxiliary data.
RAW_DATA_DIR=/DATA2/estancias/tesis_javier/model_DATA/genotipoXambiente_raw

# Reproducible working directory, usually the root of this repo clone.
WORK_DIR=/DATA2/estancias/tesis_javier/model_DATA/genotipoXambiente

# IWGSC/Chinese Spring FASTA for regulatory model. Keep .fai beside it.
REFERENCE_FASTA=/DATA2/estancias/tesis_javier/reference/IWGSC_RefSeq_v1.0.fa

# Conda environments used in SLURM scripts.
BASE_ENV=wheat80k
TRAIN_ENV=wheattrain
